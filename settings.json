{
  "packages": [
    "npm:pi-models-discovery",
    "npm:pi-blackhole",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-fff",
    "npm:pi-undo-redo",
    "npm:pi-config-sync",
    "npm:@yuritoledo/vibe-wise-pi",
    "npm:pi-paster",
    "npm:pi-multiagent",
    "npm:@the-agency/pi-tokenshrink"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "worker": {
        "model": "nvidia/poolside/laguna-xs-2.1"
      }
    }
  },
  "hideThinkingBlock": false,
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "recall"
  ],
  "compaction": {
    "modelOverrides": {
      "lun/groq/qwen/qwen3.8-27b": {
        "reserveTokens": 1500,
        "keepRecentTokens": 2000
      },
      "groq/qwen/qwen3.8-27b": {
        "reserveTokens": 2000,
        "keepRecentTokens": 2000
      }
    }
  },
  "retry": {
    "maxRetries": 3,
    "baseDelayMs": 15000,
    "maxAgentDelayMs": 65000
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-blackhole\",\"scope\":\"user\"}": "0.5.18",
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.89.1",
    "{\"source\":\"npm:pi-multiagent\",\"scope\":\"user\"}": "0.9.8"
  }
}
